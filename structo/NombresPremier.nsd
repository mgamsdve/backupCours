<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-34" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="mgamsdve" created="2025-12-01" changedby="mgamsdve" changed="2025-12-08" origin="Structorizer 3.32-34" text="&#34;NombresPremier&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;compteurNbrPremier = 0&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;nombresPremiers = &#34;&#34;&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;nombre = 2&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<repeat text="&#34;until compteurNbrPremier == N&#34;" comment="" color="ffffff" disabled="0">
			<qRepeat>
				<instruction text="&#34;nbrEstPremier = True&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<for text="&#34;for diviseur=2; diviseur &#60;= (nombre - 1); diviseur++;&#34;" comment="" counterVar="dummy_counter" startValue="diviseur=2; diviseur &#60;= (nombre - 1); diviseur++;" stepConst="1" style="FREETEXT" color="ffffff" disabled="0">
					<qFor>
						<alternative text="&#34;nombre % diviseur == 0&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
							<qTrue>
								<instruction text="&#34;nbrEstPremier = False&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
							</qTrue>
							<qFalse color="ffffff">
							</qFalse>
						</alternative>
					</qFor>
				</for>
				<alternative text="&#34;nombreEstPremier&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;nombresPremiers += nombre + &#34;&#34;, &#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;compteurNbrPremier += 1&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse color="ffffff">
					</qFalse>
				</alternative>
				<instruction text="&#34;nombre += 1&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qRepeat>
		</repeat>
	</children>
</root>