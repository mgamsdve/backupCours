<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-34" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" namespace="" author="mgamsdve" created="2025-12-01" changedby="mgamsdve" changed="2025-12-01" origin="Structorizer 3.32-34" text="&#34;ChiffreDivise&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<repeat text="&#34;until (nombre &#62;= 0) &amp;&amp; (nombre &#60; 10000)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
			<qRepeat>
				<instruction text="&#34;Lire nombre&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qRepeat>
		</repeat>
		<for text="&#34;for chiffre=2 to 9; chiffre += 1&#34;" comment="&#34;&#34;" counterVar="dummy_counter" startValue="chiffre=2" endValue="9; chiffre += 1" stepConst="1" style="FREETEXT" color="ffffff" disabled="0">
			<qFor>
				<alternative text="&#34;(nombre % chiffre) =  0&#34;" comment="&#34;&#34;" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;afficher chiffre&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse color="ffffff">
					</qFalse>
				</alternative>
			</qFor>
		</for>
	</children>
</root>